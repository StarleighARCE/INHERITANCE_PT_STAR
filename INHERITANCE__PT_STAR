<?php
class Product {
    public $name;
    public $price;
    public $category;

    public function __construct($name, $price, $category) {
        $this->name = $name;
        $this->price = $price;
        $this->category = $category;
    }

    public function getDetails() {
        return "Name: " . $this->name . "<br>Price: " . $this->price . "<br>Category: " . $this->category;
    }
}

require_once 'Product.php';

class Electronics extends Product {
    public $warrantyPeriod;

    public function __construct($name, $price, $category, $warrantyPeriod) {
        parent::__construct($name, $price, $category);
        $this->warrantyPeriod = $warrantyPeriod;
    }

    public function getDetails() {
        return parent::getDetails() . "<br>Warranty Period: " . $this->warrantyPeriod;
    }
}

